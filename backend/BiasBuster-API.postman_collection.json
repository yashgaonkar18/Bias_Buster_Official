      "name": "Mitigation Apply",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensitive_attributes\": [\"attr1\"],\n  \"bias_scores\": {\"score1\": 0.5},\n  \"strategy_config\": {}\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/mitigation/apply/smote/1", "host": ["{{baseUrl}}"], "path": ["api", "mitigation", "apply", "smote", "1"] }
