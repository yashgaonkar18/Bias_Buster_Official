      }
    },
    {
      "name": "Mitigation Auto-Experiment",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensitive_attributes\": [\"attr1\"],\n  \"bias_scores\": {\"score1\": 0.5}\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/mitigation/auto-experiment/1", "host": ["{{baseUrl}}"], "path": ["api", "mitigation", "auto-experiment", "1"] }
