{
  "info": {
    "_postman_id": "biasbuster-api-collection",
    "name": "BiasBuster API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Upload Files",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "dataset_file", "type": "file", "src": "" },
            { "key": "model_file", "type": "file", "src": "" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/api/upload", "host": ["{{baseUrl}}"], "path": ["api", "upload"] }
      }
    },
    {
      "name": "Bias Baseline",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"param1\": \"value\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/bias/baseline", "host": ["{{baseUrl}}"], "path": ["api", "bias", "baseline"] }
      }
    },
    {
      "name": "Bias Detect",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"param1\": \"value\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/bias/detect", "host": ["{{baseUrl}}"], "path": ["api", "bias", "detect"] }
      }
    },
    {
      "name": "Get Bias Report",
      "request": {
        "method": "GET",
        "header": [],
