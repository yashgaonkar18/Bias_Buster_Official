# BiasBuster Backend Configuration - Example

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/biasbuster

# Security
SECRET_KEY=your_super_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth (Optional - For Google/GitHub Login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=BiasBuster <onboarding@resend.dev>
EMAIL_REPLY_TO=support@biasbuster.com
EMAIL_SUPPORT=support@biasbuster.com

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
